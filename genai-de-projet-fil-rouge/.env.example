# Le LLM est auto-heberge via Ollama (voir docker-compose.yml) : pas de cle API cloud.
# La bibliotheque openai exige quand meme une valeur non vide ici, mais elle n'est jamais verifiee par Ollama.
OPENAI_API_KEY=ollama-local
OPENAI_BASE_URL=http://ollama:11434/v1

# Modele servi par Ollama (telecharge via scripts/pull_model.sh)
LLM_MODEL=mistral
